    {
     "kind": "loader",
     "id": "ultimate-asi-loader"
    }
   ],
   "changed": true,
   "why": "Melty installs and manages Ultimate ASI Loader; it replaces the dinput8.dll the original shipped, and loads MCPassthrough.asi and ReShade64.asi from GTA's folder the same way."
  },
  {
   "key": "mappings",
   "original": [
    {
     "to": "{game}",
     "from": "gta/",
     "component": "main"
    },
    {
     "to": "{localappdata}/MCPassthrough/credits",
     "from": "credits/",
     "component": "main"
    },
    {
     "to": "{localappdata}/MCPassthrough",
     "from": "",
     "component": "minecraft"
    }
   ],
   "remix": [
    {
     "to": "{game}",
     "from": "gta/",
     "component": "main"
    },
    {
     "to": "{localappdata}/MCPassthrough/credits",
     "from": "credits/",
     "component": "main"
    },
    {
     "to": "{localappdata}/MCPassthrough",
     "from": "",
     "component": "minecraft"
    }
   ],
   "changed": false,
   "why": "Same folders as the original: gta/ into GTA's folder, credits and Minecraft under {localappdata}/MCPassthrough."
  },
  {
   "key": "launch",
   "original": {
    "kind": "game"
   },
   "remix": {
    "kind": "game",
    "args": [
     "-nobattleye",
     "-noBE"
    ]
   },
   "changed": true,
   "why": "The arguments the original wrote into args.txt (BattlEye off, so Script Hook V runs) are passed by Melty only when it starts GTA for this mashup, so nothing in GTA's folder turns BattlEye off for other launches."
  },
  {
